{
  "name": "im8-battle-bus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "seed:locations": "tsx scripts/seed-locations-with-inventory.ts",
    "dev": "next dev -p 7000",
    "dev:inngest": "npx inngest-cli@latest dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:inngest\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "tunnel": "npx cloudflared tunnel --url http://localhost:3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --testPathPattern='src/.*/(__tests__|__test__)/'",
    "test:integration": "vitest run --testPathPattern='tests/integration/'",
    "test:e2e": "vitest run --testPathPattern='tests/e2e/' --testTimeout=120000",
    "test:coverage": "vitest run --coverage",
    "test:api": "npx tsx scripts/test-api-connections.ts",
    "test:gps-product": "npx tsx scripts/test-gps-product-sync.ts",
    "test:d365-product": "npx tsx scripts/test-d365-product-sync.ts",
    "test:product-hub": "npx tsx scripts/test-product-to-hub.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@inngest/realtime": "^0.4.5",
    "@slack/webhook": "^7.0.6",
    "@supabase/supabase-js": "^2.95.3",
    "inngest": "^3.49.3",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.0",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prettier": "^3.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
